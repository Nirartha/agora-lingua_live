# Server-only settings. Never prefix these with NEXT_PUBLIC_.
# Keep actual values in .env.local or Vercel Environment Variables, not Git.

# Required locally and on Vercel. Use the same Agora Project as your builder.
AGORA_APP_ID=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Your HTTPS builder root URL; no query parameters or embedded credentials.
# The App Certificate stays in the builder, never in this application.
TOKEN_BUILDER_URL=

# Required on Vercel; optional locally (local event state uses .data/).
# Use the HTTPS REST URL and a read/write REST Token, not a TCP endpoint.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required on Vercel. Hosts enter this shared code when creating an event.
# Audience members do not need it. This is not a membership login.
DEMO_ACCESS_CODE=

# Required on Vercel: stable HTTPS origin, with no path or query.
# First deploy to obtain the domain, then set SITE_URL and Redeploy.
# Optional locally; a temporary audience tunnel is detected separately.
SITE_URL=

# Required on Vercel; only needed locally if calling POST /api/cleanup.
# Separate random secret for maintenance callers; not entered by hosts/viewers.
# This does NOT create an automatic cleanup schedule.
CLEANUP_SECRET=

# Optional: isolate Production and Preview if sharing a Redis database.
REDIS_KEY_PREFIX=captions

# Optional defaults; match your enabled service contract and region.
AGORA_API_BASE_URL=https://api.agora.io
AGORA_V2V_PRESET=v2vt_base

# Optional: only if your builder already accepts Bearer authentication.
TOKEN_BUILDER_API_KEY=
