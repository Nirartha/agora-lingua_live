# 本機與 Vercel 後端設定。不要加 NEXT_PUBLIC_，不要把 Secret 貼進對話。
AGORA_APP_ID=
TOKEN_BUILDER_URL=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# 請按 Project 可用區域設定，範例使用全球生產端點。
AGORA_API_BASE_URL=https://api.agora.io
AGORA_V2V_PRESET=v2vt_base

# HTTPS 分享網址；本機留空則依瀏覽器網址產生（手機不可使用 localhost）。
SITE_URL=

# 公開部署必填。活動建立用的展示控制碼，不是會員登入。
DEMO_ACCESS_CODE=

# 本機可留空：狀態保存在 .data/，不會保存錄音或字幕。
# Vercel 必填：設定相容的 Upstash Redis REST 服務。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 可選：Worker 若已有 Bearer 保護才設定；不會修改 Worker。
TOKEN_BUILDER_API_KEY=
# Vercel 必填：清理 API 的 Bearer Secret。排程須另行配置，見部署指南。
CLEANUP_SECRET=

# Optional: separate Redis namespaces for Production / Preview deployments.
REDIS_KEY_PREFIX=captions
